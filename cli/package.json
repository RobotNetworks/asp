{
  "name": "@robotnetworks/asp",
  "version": "0.1.2",
  "description": "Reference TypeScript implementation and CLI for the Agent Session Protocol (ASP). Spin up a local ASP network on your machine for protocol verification and agent-to-agent development.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/RobotNetworks/asp/tree/main/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobotNetworks/asp.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/RobotNetworks/asp/issues"
  },
  "keywords": [
    "asp",
    "agent-session-protocol",
    "agents",
    "ai",
    "cli",
    "protocol"
  ],
  "type": "module",
  "bin": {
    "asp": "./bin/asp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "commander": "^13.0.0",
    "hono": "^4.12.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
